{
  "functions": {
    "api/*.js": {
      "includeFiles": "{js/**,product-template.html,category-template.html}"
    }
  },
  "rewrites": [
    {
      "source": "/product",
      "destination": "/api/product-page"
    },
    {
      "source": "/product.html",
      "destination": "/api/product-page"
    },
    {
      "source": "/category",
      "destination": "/api/category-page"
    },
    {
      "source": "/category.html",
      "destination": "/api/category-page"
    },
    {
      "source": "/google-merchant-feed.xml",
      "destination": "/api/merchant-feed"
    },
    {
      "source": "/product-image/:id/main.jpg",
      "destination": "/api/product-image?id=:id&index=0"
    },
    {
      "source": "/product-image/:id/:index.jpg",
      "destination": "/api/product-image?id=:id&index=:index"
    },
    {
      "source": "/product-image/:id",
      "destination": "/api/product-image?id=:id&index=0"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/connect",
      "destination": "/connect.html"
    },
    {
      "source": "/review",
      "destination": "/connect.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/(.*)\\.(sql|env|bak|backup)",
      "destination": "/404.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.sreedesigners.in"
        }
      ],
      "destination": "https://sreedesigners.in/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.sreedesigners.in"
        }
      ],
      "destination": "https://sreedesigners.in/$1",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog-post",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "blog-(?<slug>.*)"
        }
      ],
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/blog-post",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/blog-:slug",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/blog-why-luxury-bridal-blouses-cost-5000-to-25000",
      "destination": "/blog/why-luxury-bridal-blouses-cost-5000-to-25000",
      "permanent": true
    },
    {
      "source": "/blog-trending-bridal-sleeve-designs-2026",
      "destination": "/blog/trending-bridal-sleeve-designs-2026",
      "permanent": true
    },
    {
      "source": "/blog-front-neck-designs-jewelry-guide-2026",
      "destination": "/blog/front-neck-designs-jewelry-guide-2026",
      "permanent": true
    },
    {
      "source": "/blog-bridal-blouse-stitching-coimbatore-tiruppur",
      "destination": "/blog/bridal-blouse-stitching-coimbatore-tiruppur",
      "permanent": true
    },
    {
      "source": "/blog-trending-back-neck-designs-2026",
      "destination": "/blog/trending-back-neck-designs-2026",
      "permanent": true
    },
    {
      "source": "/blog-express-bridal-stitching-coimbatore",
      "destination": "/blog/express-bridal-stitching-coimbatore",
      "permanent": true
    },
    {
      "source": "/blog-south-indian-bridal-lehengas-2026",
      "destination": "/blog/south-indian-bridal-lehengas-2026",
      "permanent": true
    },
    {
      "source": "/blog-bridal-blouse-designs-2026",
      "destination": "/blog/bridal-blouse-designs-2026",
      "permanent": true
    },
    {
      "source": "/blog-hand-vs-machine-embroidery",
      "destination": "/blog/hand-vs-machine-embroidery",
      "permanent": true
    },
    {
      "source": "/blog-color-contrast-combinations-2026",
      "destination": "/blog/color-contrast-combinations-2026",
      "permanent": true
    },
    {
      "source": "/blog-preserve-zardozi-silk-blouse",
      "destination": "/blog/preserve-zardozi-silk-blouse",
      "permanent": true
    },
    {
      "source": "/blog-boat-neck-bridal-blouses-2026",
      "destination": "/blog/boat-neck-bridal-blouses-2026",
      "permanent": true
    },
    {
      "source": "/blog-bridal-trousseau-checklist-timeline",
      "destination": "/blog/bridal-trousseau-checklist-timeline",
      "permanent": true
    },
    {
      "source": "/blog-plus-size-saree-blouse-fitting-guide",
      "destination": "/blog/plus-size-saree-blouse-fitting-guide",
      "permanent": true
    },
    {
      "source": "/blog-salwar-chudidhar-post-wedding-rituals",
      "destination": "/blog/salwar-chudidhar-post-wedding-rituals",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(jpg|jpeg|png|webp|svg|gif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).(html|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(admin|connect|blog|product)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "cleanUrls": true
}